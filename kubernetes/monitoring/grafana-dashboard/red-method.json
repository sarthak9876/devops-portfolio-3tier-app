{
  "dashboard": {
    "title": "TaskMaster - RED Metrics",
    "tags": ["taskmaster", "red", "sre"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "30s",
    "annotations": {
      "list": [{
        "name": "Deployments",
        "datasource": "Prometheus",
        "enable": true,
        "expr": "changes(kube_deployment_status_observed_generation{namespace=\\"taskmaster-dev\\"}[5m]) > 0",
        "iconColor": "blue",
        "tagKeys": "deployment",
        "textFormat": "Deployment: {{deployment}}",
        "titleFormat": "Deployment"
      }]
    },
    
    "panels": [
      {
        "id": 1,
        "title": "Request Rate (requests/sec)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{namespace=\\"taskmaster-dev\\"}[5m])) by (job, status)",
            "legendFormat": "{{job}} - {{status}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "min": 0,
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 20,
              "showPoints": "never",
              "stacking": {"mode": "normal"}
            }
          }
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "calcs": ["mean", "max", "last"]
          }
        }
      },
      
      {
        "id": 2,
        "title": "Error Rate (%)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "(sum(rate(http_requests_total{namespace=\\"taskmaster-dev\\", status=~\\"5..\\"}[5m])) by (job) / sum(rate(http_requests_total{namespace=\\"taskmaster-dev\\"}[5m])) by (job)) * 100",
            "legendFormat": "{{job}} - 5xx errors",
            "refId": "A"
          },
          {
            "expr": "(sum(rate(http_requests_total{namespace=\\"taskmaster-dev\\", status=~\\"4..\\"}[5m])) by (job) / sum(rate(http_requests_total{namespace=\\"taskmaster-dev\\"}[5m])) by (job)) * 100",
            "legendFormat": "{{job}} - 4xx errors",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 1, "color": "yellow"},
                {"value": 5, "color": "red"}
              ]
            }
          }
        }
      },
      
      {
        "id": 3,
        "title": "Response Time (p50, p95, p99)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{namespace=\\"taskmaster-dev\\"}[5m])) by (le, job))",
            "legendFormat": "{{job}} - p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{namespace=\\"taskmaster-dev\\"}[5m])) by (le, job))",
            "legendFormat": "{{job}} - p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{namespace=\\"taskmaster-dev\\"}[5m])) by (le, job))",
            "legendFormat": "{{job}} - p99",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "min": 0,
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 1, "color": "yellow"},
                {"value": 2, "color": "red"}
              ]
            }
          }
        }
      },
      
      {
        "id": 4,
        "title": "Request Distribution by Status",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
        "targets": [{
          "expr": "sum(increase(http_requests_total{namespace=\\"taskmaster-dev\\"}[24h])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }],
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "calcs": ["sum", "percent"]
          },
          "pieType": "donut"
        }
      },
      
      {
        "id": 5,
        "title": "Top 5 Slowest Endpoints",
        "type": "table",
        "gridPos": {"h": 8, "w": 16, "x": 8, "y": 16},
        "targets": [{
          "expr": "topk(5, histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{namespace=\\"taskmaster-dev\\"}[5m])) by (le, endpoint)))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "__name__": true,
                "le": true
              },
              "renameByName": {
                "endpoint": "Endpoint",
                "Value": "P95 Latency (s)"
              }
            }
          }
        ]
      }
    ]
  }
}
