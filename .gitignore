# ═══════════════════════════════════════════════════════════════
# CRITICAL SECURITY - NEVER COMMIT THESE FILES
# ═══════════════════════════════════════════════════════════════

# AWS Credentials
**/.aws/
**/credentials
**/config
*.pem
*.key
*-key.json
aws-credentials.txt

# SSH Keys
id_rsa
id_rsa.pub
*.ppk

# Kubernetes Secrets (actual secret files, not templates)
**/02-secret.yaml
**/secrets/
**/*-secret.yaml
!**/*-secret-template.yaml

# Environment files with secrets
.env
.env.local
.env.*.local
.env.production
**/.env

# Helm values files with secrets (allow templates)
**/values-secrets.yaml
**/values-production.yaml
!**/values-production-template.yaml

# Terraform sensitive files
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl
terraform.tfvars
*.auto.tfvars
**/override.tf
**/override.tf.json

# IAM policy documents (may contain account IDs)
trust-policy.json
trust-policy-fixed.json
ebs-csi-driver-policy.json
iam-oidc-policy.json

# Backup files (may contain old secrets)
*.bak
*.backup
*-backup.*
*.old

# Certificate files
*.crt
*.csr
*.der
*.p12
*.pfx

# ═══════════════════════════════════════════════════════════════
# APPLICATION DEPENDENCIES
# ═══════════════════════════════════════════════════════════════

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/

# Java
target/
*.class
*.jar
*.war

# Go
vendor/
*.exe
*.test
*.out

# ═══════════════════════════════════════════════════════════════
# BUILD ARTIFACTS
# ═══════════════════════════════════════════════════════════════

# Frontend build
dist/
build/
.next/
out/

# Logs
*.log
logs/
*.log.*

# Docker
**/.dockerignore

# ═══════════════════════════════════════════════════════════════
# IDE & EDITOR FILES
# ═══════════════════════════════════════════════════════════════

# VSCode
.vscode/
*.code-workspace

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Vim
*.swp
*.swo
*.swn
*~

# Emacs
*~
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# ═══════════════════════════════════════════════════════════════
# OPERATING SYSTEM FILES
# ═══════════════════════════════════════════════════════════════

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# ═══════════════════════════════════════════════════════════════
# TEMPORARY FILES
# ═══════════════════════════════════════════════════════════════

*.tmp
*.temp
temp/
tmp/
.cache/

# ═══════════════════════════════════════════════════════════════
# KUBERNETES & HELM
# ═══════════════════════════════════════════════════════════════

# Helm charts downloaded
charts/*.tgz

# Kubeconfig files
kubeconfig
kubeconfig.*
config-*

# ═══════════════════════════════════════════════════════════════
# MONITORING & OBSERVABILITY
# ═══════════════════════════════════════════════════════════════

# Prometheus data
prometheus-data/

# Grafana data
grafana-data/

# Logs
elasticsearch-data/
logstash-data/

# ═══════════════════════════════════════════════════════════════
# PROJECT-SPECIFIC
# ═══════════════════════════════════════════════════════════════

# Verification scripts (contain account IDs)
verify-*.sh

# AWS CLI output files
describe-*.json
list-*.json

# Test files
test-output/
coverage/

kubernetes/manifests/02-secrets.yml
02-secrets.yml
